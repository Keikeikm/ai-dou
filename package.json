{
  "name": "ai-dou",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json && node tools/copy-skills.mjs",
    "build:client": "tsc -p client/tsconfig.json && vite build",
    "test": "vitest run",
    "cli": "tsx tools/cli.ts",
    "ui": "tsx server/main.ts",
    "dev": "tsx watch server/main.ts",
    "start": "node dist/server/main.js --production",
    "agent:example": "tsx tools/example-agent.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@antv/ava": "^3.4.1",
    "@fontsource/lxgw-wenkai-tc": "^5.3.1",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
