{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI DOU Agent decision response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "action"],
  "properties": {
    "protocol_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^room_[a-f0-9]{12}:[1-9][0-9]*:[1-9][0-9]*$" },
    "action": { "enum": ["call_1", "call_2", "call_3", "pass", "play"] },
    "cards": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:(?:spades|hearts|clubs|diamonds)-(?:[3-9]|10|J|Q|K|A|2)|joker-(?:little|big))$" } }
  },
  "if": { "properties": { "action": { "const": "play" } } },
  "then": { "required": ["cards"], "properties": { "cards": { "minItems": 1 } } },
  "else": { "properties": { "cards": { "maxItems": 0 } } }
}
