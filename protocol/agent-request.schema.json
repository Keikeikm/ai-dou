{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI DOU Agent decision request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "room_id", "generation", "round", "seat", "role", "hand_cards", "visible_cards", "bottom_cards", "history", "last_play", "call_score", "action_type", "deadline_at"],
  "properties": {
    "protocol_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^room_[a-f0-9]{12}:[1-9][0-9]*:[1-9][0-9]*$" },
    "room_id": { "type": "string", "pattern": "^room_[a-f0-9]{12}$" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "round": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "seat": { "$ref": "#/$defs/seat" },
    "role": { "enum": [null, "landlord", "farmer"] },
    "hand_cards": { "$ref": "#/$defs/cards", "minItems": 1 },
    "visible_cards": {
      "type": "object", "additionalProperties": false, "required": ["seat_0", "seat_1", "seat_2"],
      "properties": { "seat_0": { "$ref": "#/$defs/count" }, "seat_1": { "$ref": "#/$defs/count" }, "seat_2": { "$ref": "#/$defs/count" } }
    },
    "bottom_cards": { "$ref": "#/$defs/cards", "maxItems": 3 },
    "history": {
      "type": "array", "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["seat", "action", "cards"],
        "properties": { "seat": { "$ref": "#/$defs/seat" }, "action": { "enum": ["call", "play", "pass"] }, "cards": { "$ref": "#/$defs/cards" }, "score": { "type": "integer", "minimum": 0, "maximum": 3 } },
        "allOf": [
          { "if": { "properties": { "action": { "const": "call" } } }, "then": { "required": ["score"], "properties": { "cards": { "maxItems": 0 } } }, "else": { "not": { "required": ["score"] } } },
          { "if": { "properties": { "action": { "const": "play" } } }, "then": { "properties": { "cards": { "minItems": 1 } } } },
          { "if": { "properties": { "action": { "const": "pass" } } }, "then": { "properties": { "cards": { "maxItems": 0 } } } }
        ]
      }
    },
    "last_play": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["seat", "cards"], "properties": { "seat": { "$ref": "#/$defs/seat" }, "cards": { "$ref": "#/$defs/cards", "minItems": 1 } } }
      ]
    },
    "call_score": { "type": "integer", "minimum": 1, "maximum": 3 },
    "action_type": { "enum": ["call", "play"] },
    "deadline_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  },
  "allOf": [
    { "if": { "properties": { "action_type": { "const": "call" } } }, "then": { "properties": { "role": { "type": "null" }, "bottom_cards": { "maxItems": 0 }, "last_play": { "type": "null" } } }, "else": { "properties": { "role": { "enum": ["landlord", "farmer"] }, "bottom_cards": { "minItems": 3 } } } }
  ],
  "$defs": {
    "seat": { "type": "integer", "minimum": 0, "maximum": 2 },
    "count": { "type": "integer", "minimum": 0, "maximum": 20 },
    "cards": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:(?:spades|hearts|clubs|diamonds)-(?:[3-9]|10|J|Q|K|A|2)|joker-(?:little|big))$" } }
  }
}
